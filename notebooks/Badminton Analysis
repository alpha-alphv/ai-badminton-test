stretches_full_video.csv\n"]},{"output_type":"execute_result","data":{"text/plain":["True"]},"metadata":{},"execution_count":17}]},{"cell_type":"code","source":["# @title STEP 8.1 — PREPARE analytics_data DICTIONARY FOR VALIDATION\n","# ------------------------------------------------\n","\n","\n","analytics_data = {}\n","\n","for label in [\"P1\", \"P2\"]:\n","    if label in speed_data and label in traj_data:\n","        analytics_data[label] = {\n","            \"speed\": speed_data[label][\"speed_mps\"].tolist(),\n","            \"distance\": np.cumsum(speed_data[label][\"dist_m\"]).tolist()\n","        }\n","    else:\n","        # create empty placeholders so validation still runs\n","        analytics_data[label] = {\"speed\": [], \"distance\": []}\n","\n","print(\"✅ analytics_data prepared with keys:\", list(analytics_data.keys()))\n","for lbl,vals in analytics_data.items():\n","    print(lbl, {k: len(v) for k,v in vals.items()})"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"MBCyE_hH3QM0","executionInfo":{"status":"ok","timestamp":1767606967183,"user_tz":-60,"elapsed":52,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"0470a4f6-44c4-4f0f-ff17-3128eceb26c3"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ analytics_data prepared with keys: ['P1', 'P2']\n","P1 {'speed': 2200, 'distance': 2200}\n","P2 {'speed': 2210, 'distance': 2210}\n"]}]},{"cell_type":"code","source":["# @title STEP 8.2 — Layer A Validation & Sanity Checks\n","# ---------------------------------------------\n","\n","print(\"🔍 Validating dynamic analytics data...\")\n","\n","for label in [\"P1\", \"P2\"]:\n","    print(f\"\\n--- {label} ---\")\n","    for key, values in analytics_data[label].items():\n","        arr = np.array(values)\n","        print(f\"{key:>12}: length={len(arr)}, \"\n","              f\"min={np.nanmin(arr):.3f}, max={np.nanmax(arr):.3f}, mean={np.nanmean(arr):.3f}\")\n","\n","        # Basic sanity checks\n","        if len(arr) == 0:\n","            raise ValueError(f\"❌ Empty list detected for {label}:{key}\")\n","        if np.isnan(np.sum(arr)):\n","            raise ValueError(f\"❌ NaN values found in {label}:{key}\")\n","\n","# Quick visual check: plot first 500 frames of metrics ------------------------\n","frames_to_show = min(500, len(analytics_data[\"P1\"][\"speed\"]))\n","\n","plt.figure(figsize=(12,8))\n","colors = {\"P1\":\"lime\",\"P2\":\"orange\"}\n","\n","for i,label in enumerate([\"P1\",\"P2\"], start=1):\n","    plt.subplot(2,1,i)\n","    plt.plot(range(frames_to_show),\n","             analytics_data[label][\"speed\"][:frames_to_show],\n","             color=colors[label], linewidth=1)\n","    plt.title(f\"{label} Speed Over Frames (first {frames_to_show})\")\n","    plt.ylabel(\"Speed [m/s]\")\n","    plt.xlabel(\"Frame index\")\n","    plt.grid(True)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# Check monotonic distance growth --------------------------------------------\n","def is_monotonic(seq):\n","    return np.all(np.diff(seq) >= -1e-6)\n","\n","mono_p1 = is_monotonic(analytics_data[\"P1\"][\"distance\"])\n","mono_p2 = is_monotonic(analytics_data[\"P2\"][\"distance\"])\n","\n","if mono_p1 and mono_p2:\n","    print(\"\\n✅ Distance progression monotonic for both players.\")\n","else:\n","    print(\"\\n⚠️ Non‑monotonic distance detected; possible tracker dropouts.\")\n","\n","step_7_module5_layerA_validated=True\n","step_7_module5_layerA_validated\n","\n","\n","# --- Save validation outputs to Drive results folder -------------------------\n","os.makedirs(results_dir, exist_ok=True)\n","\n","# Save plotted figure\n","out_plot=f\"{results_dir}/layerA_validation_speed_plot.png\"\n","plt.savefig(out_plot,bbox_inches=\"tight\")\n","print(f\"📁 Validation speed plot saved to: {out_plot}\")\n","\n","# Save numeric summary to text file\n","summary_file=f\"{results_dir}/layerA_validation_summary.txt\"\n","with open(summary_file,\"w\") as f:\n","     for label in [\"P1\",\"P2\"]:\n","         f.write(f\"\\n--- {label} ---\\n\")\n","         for key,values in analytics_data[label].items():\n","             arr=np.array(values)\n","             line=(f\"{key}: length={len(arr)}, \"\n","                   f\"min={np.nanmin(arr):.3f}, \"\n","                   f\"max={np.nanmax(arr):.3f}, \"\n","                   f\"mean={np.nanmean(arr):.3f}\\n\")\n","             f.write(line)\n","     mono_text=\"Monotonic distances OK\\n\" if (mono_p1 and mono_p2) else \"Non‑monotonic distances detected\\n\"\n","     f.write(\"\\n\"+mono_text)\n","\n","print(f\"📁 Numeric validation summary saved to: {summary_file}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":843},"id":"jESm5Wsyyo_-","executionInfo":{"status":"ok","timestamp":1767607076190,"user_tz":-60,"elapsed":573,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"1a70c1c8-f713-4812-893b-a9f4e81a179e"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["🔍 Validating dynamic analytics data...\n","\n","--- P1 ---\n","       speed: length=2200, min=0.000, max=7.901, mean=1.080\n","    distance: length=2200, min=0.026, max=79.198, mean=40.529\n","\n","--- P2 ---\n","       speed: length=2210, min=0.000, max=7.109, mean=1.236\n","    distance: length=2210, min=0.002, max=91.080, mean=47.105\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","✅ Distance progression monotonic for both players.\n","📁 Validation speed plot saved to: /content/drive/MyDrive/Badminton_Analytics_Project/results/layerA_validation_speed_plot.png\n","📁 Numeric validation summary saved to: /content/drive/MyDrive/Badminton_Analytics_Project/results/layerA_validation_summary.txt\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 0 Axes>"]},"metadata":{}}]},{"cell_type":"code","source":["# @title STEP 8.3 — PREPARE pose-based metrics for analytics_data\n","# ---------------------------------------------\n","\n","pose_csv = f\"{results_dir}/pose_metrics/pose_angles_stretches_full_video.csv\"\n","\n","if os.path.exists(pose_csv):\n","    pose_df = pd.read_csv(pose_csv)\n","    print(f\"✅ Loaded pose metrics from {pose_csv}\")\n","else:\n","    raise FileNotFoundError(\"❌ Pose metrics CSV not found. Run Module 5 Column 2 first.\")\n","\n","# Fill analytics_data with leg_stretch and body_angle from saved CSV\n","for label in [\"P1\", \"P2\"]:\n","    if label not in analytics_data:\n","        analytics_data[label] = {}\n","    # Use same data for both players until per-player separation is implemented\n","    analytics_data[label][\"leg_stretch\"] = pose_df[\"Leg_Stretch_Ratio\"].tolist()\n","    analytics_data[label][\"body_angle\"]  = pose_df[\"Body_Angle_deg\"].tolist()\n","\n","print(\"✅ Added leg_stretch and body_angle keys to analytics_data.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"I6TQdzH5FHZl","executionInfo":{"status":"ok","timestamp":1767607083968,"user_tz":-60,"elapsed":38,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"4296a0b5-a488-457c-8f77-079bfc02d995"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Loaded pose metrics from /content/drive/MyDrive/Badminton_Analytics_Project/results/pose_metrics/pose_angles_stretches_full_video.csv\n","✅ Added leg_stretch and body_angle keys to analytics_data.\n"]}]},{"cell_type":"code","source":["# @title STEP 8.4 — Extended Validation of Dynamic Metrics\n","# -------------------------------------------------\n","\n","\n","print(\"🔍 Extended validation of analytics_data contents...\")\n","\n","for label in [\"P1\", \"P2\"]:\n","    print(f\"\\n--- {label} ---\")\n","    for key, values in analytics_data[label].items():\n","        arr = np.array(values)\n","        print(f\"{key:>12}: len={len(arr)}, \"\n","              f\"min={np.nanmin(arr):.3f}, max={np.nanmax(arr):.3f}, mean={np.nanmean(arr):.3f}\")\n","        if len(arr) == 0:\n","            raise ValueError(f\"❌ Empty list detected for {label}:{key}\")\n","        if np.isnan(np.sum(arr)):\n","            raise ValueError(f\"❌ NaN values found in {label}:{key}\")\n","\n","# Plot all metrics together (first N frames)\n","frames_to_show = min(500, len(analytics_data[\"P1\"][\"speed\"]))\n","colors = {\"P1\":\"lime\",\"P2\":\"orange\"}\n","\n","fig, axes = plt.subplots(4, 2, figsize=(14,10))\n","metric_names = [\"distance\",\"speed\",\"leg_stretch\",\"body_angle\"]\n","\n","for col,label in enumerate([\"P1\",\"P2\"]):\n","    for row,key in enumerate(metric_names):\n","        ax = axes[row,col]\n","        data_slice = analytics_data[label][key][:frames_to_show]\n","        ax.plot(range(len(data_slice)), data_slice,\n","                color=colors[label], linewidth=1)\n","        ax.set_title(f\"{label} – {key.replace('_',' ').title()}\")\n","        ax.grid(True)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# Quick range sanity checks\n","def within_range(val_list, min_val, max_val):\n","    arr=np.array(val_list)\n","    return np.all((arr>=min_val)&(arr<=max_val))\n","\n","ranges_ok=True\n","if not within_range(analytics_data[\"P1\"][\"leg_stretch\"],0.3,3.0): ranges_ok=False\n","if not within_range(analytics_data[\"P2\"][\"leg_stretch\"],0.3,3.0): ranges_ok=False\n","if not within_range(analytics_data[\"P1\"][\"body_angle\"],0.0,90.0): ranges_ok=False\n","if not within_range(analytics_data[\"P2\"][\"body_angle\"],0.0,90.0): ranges_ok=False\n","\n","if ranges_ok:\n","    print(\"\\n✅ All metric ranges appear physically plausible.\")\n","else:\n","    print(\"\\n⚠️ Some metric values outside expected range; consider pose tuning.\")\n","\n","step_7_module5_layerA_extended_validated=True\n","step_7_module5_layerA_extended_validated\n","\n","\n","# --- Save extended validation outputs to Drive results folder -----------------\n","os.makedirs(results_dir, exist_ok=True)\n","\n","# Save plotted figure\n","out_plot=f\"{results_dir}/extended_validation_metrics.png\"\n","fig.savefig(out_plot,bbox_inches=\"tight\")\n","print(f\"📁 Extended metrics plot saved to: {out_plot}\")\n","\n","# Save numeric summary to text file\n","summary_file=f\"{results_dir}/extended_validation_summary.txt\"\n","with open(summary_file,\"w\") as f:\n","     for label in [\"P1\",\"P2\"]:\n","         f.write(f\"\\n--- {label} ---\\n\")\n","         for key,val in analytics_data[label].items():\n","             arr=np.array(val)\n","             line=(f\"{key}: len={len(arr)}, \"\n","                   f\"min={np.nanmin(arr):.3f}, \"\n","                   f\"max={np.nanmax(arr):.3f}, \"\n","                   f\"mean={np.nanmean(arr):.3f}\\n\")\n","             f.write(line)\n","     range_text=\"All metric ranges plausible\\n\" if ranges_ok else \"Some metric values outside expected range\\n\"\n","     f.write(\"\\n\"+range_text)\n","\n","print(f\"📁 Numeric extended validation summary saved to: {summary_file}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":935},"id":"z1DMGtc15vHQ","executionInfo":{"status":"ok","timestamp":1767607090641,"user_tz":-60,"elapsed":3140,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"e29c0a89-242a-4eea-dd56-3a5f949b7e6b"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["🔍 Extended validation of analytics_data contents...\n","\n","--- P1 ---\n","       speed: len=2200, min=0.000, max=7.901, mean=1.080\n","    distance: len=2200, min=0.026, max=79.198, mean=40.529\n"," leg_stretch: len=4425, min=0.176, max=0.872, mean=0.483\n","  body_angle: len=4425, min=0.701, max=179.416, mean=92.450\n","\n","--- P2 ---\n","       speed: len=2210, min=0.000, max=7.109, mean=1.236\n","    distance: len=2210, min=0.002, max=91.080, mean=47.105\n"," leg_stretch: len=4425, min=0.176, max=0.872, mean=0.483\n","  body_angle: len=4425, min=0.701, max=179.416, mean=92.450\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x1000 with 8 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","⚠️ Some metric values outside expected range; consider pose tuning.\n","📁 Extended metrics plot saved to: /content/drive/MyDrive/Badminton_Analytics_Project/results/extended_validation_metrics.png\n","📁 Numeric extended validation summary saved to: /content/drive/MyDrive/Badminton_Analytics_Project/results/extended_validation_summary.txt\n"]}]},{"cell_type":"code","source":["# @title STEP 9 — Real-Time Analytics Overlay (Keep Audio)\n","# -----------------------------------------------------------\n","\n","input_video = video_path\n","output_video = \"annotated_output.mp4\"\n","\n","clip = VideoFileClip(input_video)\n","fps = clip.fps\n","w, h = clip.size\n","\n","fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n","out = cv2.VideoWriter(\"temp_no_audio.mp4\", fourcc, fps, (w,h))\n","\n","cap_overlay = cv2.VideoCapture(input_video)\n","\n","frame_idx = 0\n","total_frames = int(cap_overlay.get(cv2.CAP_PROP_FRAME_COUNT))\n","print(f\"Rendering {total_frames} frames...\")\n","\n","while True:\n","    ret, frame_ovr = cap_overlay.read()\n","    if not ret:\n","        break\n","\n","    # Draw court outline\n","    cv2.polylines(frame_ovr,[court_coords.reshape((-1,1,2))],\n","                  isClosed=True,color=(255,255,255),thickness=3)\n","\n","    # Add player positions and speed text every few frames\n","    for label,color in zip([\"P1\",\"P2\"],[(0,255,0),(0,165,255)]):\n","        df = traj_data[label]\n","        if frame_idx < len(df):\n","            x,y=df.iloc[frame_idx][[\"x\",\"y\"]]\n","            spd_df=speed_data[label]\n","            if frame_idx < len(spd_df):\n","                speed_val=float(spd_df.iloc[frame_idx][\"speed_mps\"])\n","                txt=f\"{label}: {speed_val:.2f} m/s\"\n","                cv2.putText(frame_ovr,txt,(int(x)+20,int(y)-10),\n","                            cv2.FONT_HERSHEY_SIMPLEX,\n","                            0.6,color,2)\n","            cv2.circle(frame_ovr,(int(x),int(y)),8,color,-1)\n","\n","    out.write(frame_ovr)\n","    frame_idx += 1\n","\n","cap_overlay.release()\n","out.release()\n","\n","video_no_audio = VideoFileClip(\"temp_no_audio.mp4\")\n","final_clip = video_no_audio.set_audio(clip.audio)\n","final_clip.write_videofile(output_video,fps=fps)\n","\n","print(f\"\\n✅ Final annotated video saved as: {output_video}\")\n","\n","# --- Copy annotated video to Drive results folder ----------------------------\n","os.makedirs(results_dir, exist_ok=True)\n","saved_path=f\"{results_dir}/annotated_output.mp4\"\n","shutil.copy(output_video,saved_path)   # cross‑device safe copy\n","print(f\"📁 Annotated video copied to: {saved_path}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Q2Ca5a1Lx378","executionInfo":{"status":"ok","timestamp":1767607385186,"user_tz":-60,"elapsed":284533,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"10d0875a-b5b1-42ac-fb22-15af4f209b6f"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["Rendering 2211 frames...\n","Moviepy - Building video annotated_output.mp4.\n","MoviePy - Writing audio in annotated_outputTEMP_MPY_wvf_snd.mp3\n"]},{"output_type":"stream","name":"stderr","text":[]},{"output_type":"stream","name":"stdout","text":["MoviePy - Done.\n","Moviepy - Writing video annotated_output.mp4\n","\n"]},{"output_type":"stream","name":"stderr","text":[]},{"output_type":"stream","name":"stdout","text":["Moviepy - Done !\n","Moviepy - video ready annotated_output.mp4\n","\n","✅ Final annotated video saved as: annotated_output.mp4\n","📁 Annotated video copied to: /content/drive/MyDrive/Badminton_Analytics_Project/results/annotated_output.mp4\n"]}]},{"cell_type":"code","source":["# @title STEP 10.1 — SIDE-BY-SIDE COURT COMPARISON\n","\n","\n","# ---------------- LOAD DATA -------------------------------------------------\n","traj_P1 = pd.read_csv(\"/content/drive/MyDrive/Badminton_Analytics_Project/results/P1_trajectory.csv\")\n","traj_P2 = pd.read_csv(\"/content/drive/MyDrive/Badminton_Analytics_Project/results/P2_trajectory.csv\")\n","\n","# ---------------- GLOBAL NORMALIZATION -------------------------------------\n","x_min = min(traj_P1[\"x\"].min(), traj_P2[\"x\"].min())\n","x_max = max(traj_P1[\"x\"].max(), traj_P2[\"x\"].max())\n","y_min = min(traj_P1[\"y\"].min(), traj_P2[\"y\"].min())\n","y_max = max(traj_P1[\"y\"].max(), traj_P2[\"y\"].max())\n","\n","def normalize(df):\n","    nx = (df[\"x\"] - x_min) / (x_max - x_min)\n","    ny = (df[\"y\"] - y_min) / (y_max - y_min)\n","    return nx.clip(0,1), ny.clip(0,1)\n","\n","# ---------------- ZONES -----------------------------------------------------\n","def assign_zone(nx, ny):\n","    row = \"Front\" if ny < 1/3 else \"Mid\" if ny < 2/3 else \"Back\"\n","    col = \"Left\" if nx < 0.5 else \"Right\"\n","    return f\"{row} {col}\"\n","\n","def zone_distribution(df):\n","    nx, ny = normalize(df)\n","    zones = [assign_zone(x,y) for x,y in zip(nx,ny)]\n","    cnt = Counter(zones)\n","    total = sum(cnt.values())\n","    return {z:100*c/total for z,c in cnt.items()}\n","\n","# ---------------- CONFIDENCE ELLIPSE ---------------------------------------\n","def draw_ellipse(ax, x, y, color):\n","    cov = np.cov(x, y)\n","    vals, vecs = np.linalg.eigh(cov)\n","    order = vals.argsort()[::-1]\n","    vals, vecs = vals[order], vecs[:,order]\n","    theta = np.degrees(np.arctan2(*vecs[:,0][::-1]))\n","    width, height = 2 * np.sqrt(vals)\n","    ell = Ellipse((np.mean(x),np.mean(y)), width, height,\n","                  angle=theta, edgecolor=color, facecolor=\"none\", lw=3)\n","    ax.add_patch(ell)\n","\n","# ---------------- VISUAL MODE ----------------------------------------------\n","# options: \"hexbin\" | \"scatter\" | \"ellipse\"\n","VIS_MODE = \"hexbin\"\n","\n","# ---------------- COURT PLOT -----------------------------------------------\n","fig, axs = plt.subplots(2, 2, figsize=(12,18))\n","\n","players = [\n","    (\"Player 1\", traj_P1, \"green\"),\n","    (\"Player 2\", traj_P2, \"orange\")\n","]\n","\n","for i,(name,df,color) in enumerate(players):\n","    nx, ny = normalize(df)\n","    ax = axs[0,i]\n","\n","    if VIS_MODE == \"hexbin\":\n","        ax.hexbin(nx, ny, gridsize=25, cmap=\"Greens\" if i==0 else \"Oranges\")\n","    elif VIS_MODE == \"scatter\":\n","        ax.scatter(nx, ny, s=6, alpha=0.4, color=color)\n","    elif VIS_MODE == \"ellipse\":\n","        ax.scatter(nx, ny, s=4, alpha=0.3, color=color)\n","        draw_ellipse(ax, nx, ny, color)\n","\n","    # Court grid\n","    ax.axhline(1/3); ax.axhline(2/3)\n","    ax.axvline(0.5)\n","\n","    ax.set_xlim(0,1); ax.set_ylim(0,1)\n","    ax.set_title(f\"{name} – Court Presence\")\n","    ax.set_xlabel(\"Left ↔ Right\")\n","    ax.set_ylabel(\"Front ↔ Back\")\n","\n","    # --- PIE CHART ---\n","    zones = zone_distribution(df)\n","    axs[1,i].pie(zones.values(), labels=zones.keys(),\n","                 autopct=\"%1.1f%%\", startangle=90)\n","    axs[1,i].set_title(f\"{name} – Zone Occupancy\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"2q5ezb90Rpn0","executionInfo":{"status":"ok","timestamp":1767607606482,"user_tz":-60,"elapsed":743,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"5513ced6-9a81-4aa7-d8ad-7b83df15fe13"},"execution_count":24,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x1800 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# @title STEP 10.2 — FULL COURT ANALYTICS\n","\n","# ---------------- NORMALIZATION -------------------------------------------\n","x_min = min(traj_P1[\"x\"].min(), traj_P2[\"x\"].min())\n","x_max = max(traj_P1[\"x\"].max(), traj_P2[\"x\"].max())\n","y_min = min(traj_P1[\"y\"].min(), traj_P2[\"y\"].min())\n","y_max = max(traj_P1[\"y\"].max(), traj_P2[\"y\"].max())\n","\n","def normalize(df):\n","    nx = (df[\"x\"] - x_min) / (x_max - x_min)\n","    ny = (df[\"y\"] - y_min) / (y_max - y_min)\n","    return nx.clip(0,1).values, ny.clip(0,1).values\n","\n","# ---------------- SPEED ----------------------------------------------------\n","def compute_speed(df):\n","    dx = np.diff(df[\"x\"], prepend=df[\"x\"].iloc[0])\n","    dy = np.diff(df[\"y\"], prepend=df[\"y\"].iloc[0])\n","    return np.sqrt(dx**2 + dy**2)\n","\n","# ---------------- ZONES ----------------------------------------------------\n","def assign_zone(x,y):\n","    row = 0 if y < 1/3 else 1 if y < 2/3 else 2\n","    col = 0 if x < 0.5 else 1\n","    return row*2 + col   # 0..5\n","\n","# ========================================================================\n","# 1️ COURT DOMINANCE MAP (P1 − P2)\n","# ========================================================================\n","nx1, ny1 = normalize(traj_P1)\n","nx2, ny2 = normalize(traj_P2)\n","\n","h1, _, _ = np.histogram2d(nx1, ny1, bins=40, range=[[0,1],[0,1]])\n","h2, _, _ = np.histogram2d(nx2, ny2, bins=40, range=[[0,1],[0,1]])\n","\n","plt.figure(figsize=(6,10))\n","plt.imshow((h1-h2).T, origin=\"lower\", cmap=\"bwr\", aspect=\"auto\")\n","plt.colorbar(label=\"P1 dominance  ←  →  P2 dominance\")\n","plt.title(\"Court Dominance Difference Map\")\n","plt.xlabel(\"Left ↔ Right\")\n","plt.ylabel(\"Front ↔ Back\")\n","plt.show()\n","\n","# ========================================================================\n","# 2️ CONVEX HULL (COURT COVERAGE)\n","# ========================================================================\n","plt.figure(figsize=(6,10))\n","for df, label, color in [(traj_P1,\"P1\",\"green\"),(traj_P2,\"P2\",\"orange\")]:\n","    nx, ny = normalize(df)\n","    pts = np.column_stack((nx,ny))\n","    hull = ConvexHull(pts)\n","    plt.plot(pts[hull.vertices,0], pts[hull.vertices,1], color=color, lw=3)\n","    plt.scatter(nx, ny, s=3, alpha=0.3, color=color, label=label)\n","\n","plt.legend()\n","plt.title(\"Court Coverage (Convex Hull)\")\n","plt.xlabel(\"Left ↔ Right\")\n","plt.ylabel(\"Front ↔ Back\")\n","plt.show()\n","\n","# ========================================================================\n","# 3️ ZONE TRANSITION MATRIX\n","# ========================================================================\n","def transition_matrix(df):\n","    nx, ny = normalize(df)\n","    zones = [assign_zone(x,y) for x,y in zip(nx,ny)]\n","    M = np.zeros((6,6))\n","    for i in range(len(zones)-1):\n","        M[zones[i], zones[i+1]] += 1\n","    return M / M.sum(axis=1, keepdims=True)\n","\n","plt.figure(figsize=(12,4))\n","for i,(df,title) in enumerate([(traj_P1,\"P1\"),(traj_P2,\"P2\")]):\n","    plt.subplot(1,2,i+1)\n","    plt.imshow(transition_matrix(df), cmap=\"viridis\")\n","    plt.title(f\"{title} Zone Transitions\")\n","    plt.xlabel(\"To Zone\")\n","    plt.ylabel(\"From Zone\")\n","    plt.colorbar()\n","plt.show()\n","\n","# ========================================================================\n","# 4️ SPEED-WEIGHTED COURT MAP\n","# ========================================================================\n","plt.figure(figsize=(12,5))\n","for i,(df,title,cmap) in enumerate([(traj_P1,\"P1\",\"Greens\"),(traj_P2,\"P2\",\"Oranges\")]):\n","    nx, ny = normalize(df)\n","    speed = compute_speed(df)\n","    plt.subplot(1,2,i+1)\n","    plt.hexbin(nx, ny, C=speed, gridsize=25, cmap=cmap)\n","    plt.colorbar(label=\"Speed\")\n","    plt.title(f\"{title} Speed-Weighted Court Presence\")\n","    plt.xlabel(\"Left ↔ Right\")\n","    plt.ylabel(\"Front ↔ Back\")\n","plt.show()\n","\n","# ========================================================================\n","# 5️ RECOVERY POSITION (MEAN + DISPERSION)\n","# ========================================================================\n","plt.figure(figsize=(6,10))\n","for df,label,color in [(traj_P1,\"P1\",\"green\"),(traj_P2,\"P2\",\"orange\")]:\n","    nx, ny = normalize(df)\n","    plt.scatter(nx, ny, s=3, alpha=0.2, color=color)\n","    plt.scatter(nx.mean(), ny.mean(), s=200, marker=\"X\", color=color, label=label)\n","\n","plt.legend()\n","plt.title(\"Recovery / Mean Position\")\n","plt.xlabel(\"Left ↔ Right\")\n","plt.ylabel(\"Front ↔ Back\")\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"eZRcDJcieBmY","executionInfo":{"status":"ok","timestamp":1767607620776,"user_tz":-60,"elapsed":3068,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"31efcc2a-c9f1-4924-8be7-d9f76d76a031"},"execution_count":25,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x1000 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x1000 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stderr","text":["WARNING:py.warnings:/tmp/ipython-input-1259718483.py:69: RuntimeWarning: invalid value encountered in divide\n","  return M / M.sum(axis=1, keepdims=True)\n","\n","WARNING:py.warnings:/tmp/ipython-input-1259718483.py:69: RuntimeWarning: invalid value encountered in divide\n","  return M / M.sum(axis=1, keepdims=True)\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x1000 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# @title STEP 11 — Preview With Player Stats + Vertical Mini Court (Clean Version)\n","# --------------------------------------------------------------------------\n","\n","# Load YOLOv8-Pose model for joint detection\n","pose_model = YOLO(\"yolov8n-pose.pt\")\n","pose_data = pd.read_csv(pose_csv)\n","traj_P1 = pd.read_csv(\"/content/drive/MyDrive/Badminton_Analytics_Project/results/P1_trajectory.csv\")\n","traj_P2 = pd.read_csv(\"/content/drive/MyDrive/Badminton_Analytics_Project/results/P2_trajectory.csv\")\n","\n","\n","cap = cv2.VideoCapture(video_path)\n","total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","sample_count = total_frames   # process entire video\n","panel_w_ratio = 0.35\n","\n","w  = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n","h  = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n","panel_w = int(w * panel_w_ratio)\n","\n","print(f\"Generating {sample_count} preview frames...\")\n","\n","# --- Prepare output writer ---------------------------------------------------\n","fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n","out_path_temp = f\"{output_dir}/annotated_no_audio.mp4\"\n","fps = cap.get(cv2.CAP_PROP_FPS)\n","frame_size = (w + panel_w, h)   # total width: left panel + right column\n","\n","out_writer = cv2.VideoWriter(out_path_temp, fourcc, fps, frame_size)\n","\n","# --- Progress bar setup ------------------------------------------------------\n","pbar = tqdm(total=sample_count, desc=\"Rendering annotated video\", unit=\"frame\")\n","\n","preview_frames = []\n","\n","# containers to accumulate trajectory points for plotting\n","traj_points_P1 = []\n","traj_points_P2 = []\n","\n","for frame_idx in range(sample_count):\n","    ret, frame_orig = cap.read()\n","\n","    # --- Pose estimation overlay on right panel ---------------------------------\n","    results_pose = pose_model(frame_orig)\n","\n","    if hasattr(results_pose[0], \"keypoints\") and results_pose[0].keypoints is not None:\n","        kpts_list = results_pose[0].keypoints.xy.cpu().numpy()\n","\n","        for person_kpts in kpts_list:\n","            for x, y in person_kpts:\n","    