g,\n","             (center_x - service_line_offset, top_y),\n","             (center_x - service_line_offset, bottom_y),\n","             court_color, 1)\n","\n","    # Right-side vertical service line\n","    cv2.line(court_img,\n","             (center_x + service_line_offset, top_y),\n","             (center_x + service_line_offset, bottom_y),\n","             court_color, 1)\n","\n","    # Center service line vertically through middle of width axis\n","    center_x=(left_x+right_x)//2\n","    cv2.line(court_img,(center_x,top_y),(center_x,bottom_y),court_color,3)\n","\n","    service_offset=int((bottom_y-top_y)*0.4)\n","    cv2.line(court_img,(left_x,net_y-service_offset),\n","             (right_x,net_y-service_offset),court_color,1)\n","    cv2.line(court_img,(left_x,net_y+service_offset),\n","             (right_x,net_y+service_offset),court_color,1)\n","\n","    side_inset=int((right_x-left_x)*0.023)\n","    cv2.rectangle(court_img,(left_x+side_inset,top_y),\n","                  (right_x-side_inset,bottom_y),court_color,1)\n","\n","\n","    # --- Add player labels to left and right sides of horizontal court -------\n","    label_fontscale = 0.9\n","    label_thickness = 3\n","\n","    color_p1 = (0, 255, 0)       # same green as Player 1 stats\n","    color_p2 = (0, 165, 255)     # same orange as Player 2 stats\n","\n","    # Vertical position for both texts: roughly mid‑court height\n","    text_y = int((top_y + bottom_y) / 2)\n","\n","    # Horizontal positions: just outside outer boundaries\n","    left_label_x  = max(left_x - int(w * 0.07), 70)\n","    right_label_x = min(right_x + int(w * 0.02), w - 100)\n","\n","\n","    cv2.putText(court_img,\n","                \"P 1\",\n","                (left_label_x, text_y),\n","                cv2.FONT_HERSHEY_SIMPLEX,\n","                label_fontscale,\n","                color_p1,\n","                label_thickness)\n","\n","    cv2.putText(court_img,\n","                \"P 2\",\n","                (right_label_x, text_y),\n","                cv2.FONT_HERSHEY_SIMPLEX,\n","                label_fontscale,\n","                color_p2,\n","                label_thickness)\n","\n","\n","    # --- Draw accumulated trajectories on horizontal mini-court -------------\n","    color_p1 = (0, 255, 0)     # Green\n","    color_p2 = (0, 165, 255)   # Orange\n","\n","    # --- GLOBAL normalization (both players together) ---------------------------\n","    x_min = min(traj_P1[\"x\"].min(), traj_P2[\"x\"].min())\n","    x_max = max(traj_P1[\"x\"].max(), traj_P2[\"x\"].max())\n","    y_min = min(traj_P1[\"y\"].min(), traj_P2[\"y\"].min())\n","    y_max = max(traj_P1[\"y\"].max(), traj_P2[\"y\"].max())\n","\n","    court_width  = right_x - left_x\n","    court_height = bottom_y - top_y\n","\n","    def map_to_minicourt_vertical_flip(pt):\n","      # normalize real court\n","      nx = (pt[0] - x_min) / max(1e-6, x_max - x_min)\n","      ny = (pt[1] - y_min) / max(1e-6, y_max - y_min)\n","\n","      # ---- YOUR EXISTING correct orientation ----\n","      cx = int(left_x + ny * court_width)\n","      cy = int(top_y  + nx * court_height)\n","\n","      # ---- ONLY vertical flip (1<->2, 3<->4) ----\n","      cy = int(top_y + bottom_y - cy)\n","\n","      return cx, cy\n","\n","    # --- Player 1 ---------------------------------------------------------------\n","    for pt in traj_points_P1:\n","      cx, cy = map_to_minicourt_vertical_flip(pt)\n","      cv2.circle(court_img, (cx, cy), 3, color_p1, -1)\n","\n","    # --- Player 2 ---------------------------------------------------------------\n","    for pt in traj_points_P2:\n","      cx, cy = map_to_minicourt_vertical_flip(pt)\n","      cv2.circle(court_img, (cx, cy), 3, color_p2, -1)\n","\n","    # -----------------------------------------------------------------------\n","    # --- Resize video (smaller) and court (larger) for right column -------------\n","    video_scale = 0.50   # fraction of total height for video\n","    cou