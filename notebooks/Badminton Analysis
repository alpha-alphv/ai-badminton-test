urt_coords[:,1])\n","        if y2 < min_y_court_top - 20:   # entire bbox above court → reject\n","            continue\n","\n","        if not inside_court_zone:\n","            continue\n","\n","        # Assign identity once per track id based on initial position within frame height\n","        if id_ not in player_map:\n","            label = \"P1\" if cy_adj < h/2 else \"P2\"\n","            player_map[id_] = label\n","\n","        trajectories[player_map[id_]].append((frame_idx,cx,cy_adj))\n","\n","    frame_idx += 1\n","\n","print(\"\\n✅ Assigned identities after refinement:\")\n","for tid,label in player_map.items():\n","    print(f\"Track {int(tid)} → {label}\")\n","\n","# Visualization sample frames again\n","cap_vis=cv2.VideoCapture(video_path)\n","sample_indices_vis=sorted(random.sample(range(frame_idx),min(10,frame_idx)))\n","\n","for idx in sample_indices_vis:\n","    cap_vis.set(cv2.CAP_PROP_POS_FRAMES,idx)\n","    ret,frame_vis=cap_vis.read()\n","    if not ret:\n","       continue\n","\n","    overlay=cv2.cvtColor(frame_vis,cv2.COLOR_BGR2RGB).copy()\n","\n","    cv2.polylines(overlay,[court_coords.reshape((-1,1,2))],\n","                  isClosed=True,color=(255,0,0),thickness=3)\n","\n","    for label,color in zip([\"P1\",\"P2\"],[(0,255,0),(255,165,0)]):\n","       pts=[p for p in trajectories[label] if abs(p[0]-idx)<3]\n","       for _,cx_,cy_ in pts:\n","           cv2.circle(overlay,(int(cx_),int(cy_)),6,color,-1)\n","           cv_label=f\"{label}\"\n","           cv2.putText(overlay,cv_label,(int(cx_),int(cy_-10)),\n","                       cv2.FONT_HERSHEY_SIMPLEX,0.6,color,3)\n","\n","    plt.figure(figsize=(9,5))\n","    plt.imshow(overlay)\n","    plt.title(f\"Frame {idx} | Refined Player Tracking\")\n","    plt.axis('off')\n","    plt.show()\n","\n","cap_vis.release()\n","\n","unique_labels=set(player_map.values())\n","consistent=len(unique_labels)==2 and all(len(v)>10 for v in trajectories.values())\n","\n","if consistent:\n","   pri