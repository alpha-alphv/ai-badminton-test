model(frame)\n","    boxes=results[0].boxes.data.cpu().numpy()\n","\n","    p_centers=[]\n","    s_center=None\n","    for b in boxes:\n","        cls_id=int(b[5])\n","        name=results[0].names.get(cls_id,\"\").lower()\n","        x1,y1,x2,y2=b[:4]\n","        cx=(x1+x2)/2; cy=(y1+y2)/2\n","        if \"shuttle\" in name:\n","            s_center=(cx,cy)\n","        elif \"person\" in name or \"player\" in name:\n","            p_centers.append((cx,cy))\n","    if s_center: shuttle_xy.append((frame_idx,*s_center))\n","    player_boxes.append((frame_idx,p_centers))\n","    frame_idx+=1\n","\n","cap.release()\n","print(f\"Collected {len(shuttle_xy)} shuttle detections.\")\n","\n","frames=np.array([p[0] for p in shuttle_xy])\n","x=np.array([p[1] for p in shuttle_xy])\n","y=np.array([p[2] for p in shuttle_xy])\n","\n","vx=np.diff(x); vy=np.diff(y)\n","speed_px_per_frame=np.sqrt(vx**2+vy**2)\n","\n","scale_m_per_px=13/frame_rgb.shape[1]\n","speed_mps=speed_px_per_frame*scale_m_per_px*fps\n","accel=np.abs(np.diff(speed_mps))\n","\n","accel_threshold=np.mean(accel)+1.6*np.std(accel)\n","event_indices=list(np.where(accel>accel_threshold)[0])\n","\n","# Add first valid frame so serve isn’t skipped\n","merged_events=[0]\n","last_event=-9999\n","for eidx in event_indices:\n","   if eidx-last_event>4:\n","       merged_events.append(eidx)\n","       last_event=eidx\n","\n","print(f\"Detected {len(event_indices)} raw spikes; merged down to {len(merged_events)} candidate shots including serve.\")\n","\n","# --- Assign player who hit based on proximity at that frame -------------------\n","shot_records=[]\n","prev_player=None\n","\n","for i,eidx in enumerate(merged_events):\n","   fnum=int(frames[eidx]) if eidx < len(frames) else int(frames[-1])\n","   sx=x[min(eidx,len(x)-1)]\n","   sy=y[min(eidx,len(y)-1)]\n","\n","   near_players=[pb for pb in player_boxes if abs(pb[0]-fnum)<=3]\n","   hitter=\"Unknown\"\n","   if near_players and len(near_players[-1][1])>=2:\n","       dists=[np.linalg.norm([(sx-px),(sy-py)]) for (px,py) in near_players[-1][1]]\n","       min_i=int(np.argmin(dists))\n","       hitter=f\"P{min_i+1}\"\n","\n","   # alternate automatically when same id repeats or unknown\n","   if prev_player==hitter or hitter==\"Unknown\":\n","       hitter=\"P1\" if prev_player==\"P2\" else \"P2\"\n","\n","   prev_player=hitter\n","\n","   dx=x[min(eidx+1,len(x)-1)]-x[eidx]; dy=y[min(eidx+1,len(y)-1)]-y[eidx]\n","   angle_deg=abs(np.degrees(np.arctan2(dy,dx)))\n","   v_next=speed_mps[min(eidx,len(speed_mps)-1)]\n","\n","   # classify purely by motion geometry from trained model output\n","   stype=\"smash\" if v_next>np.percentile(speed_mps,75) else \\\n","          \"drive\" if angle_deg<20 else \\\n","          \"clear\" if angle_deg>45 else \\\n","          \"net/drop\"\n","\n","   shot_records.append({\n","       \"Shot_Number\":i+1,\n","       \"Frame\":fnum,\n","       \"Shot_Type\":stype,\n","       \"Player\":hitter\n","   })\n","\n","rally_df=pd.DataFrame(shot_records)\n","\n","total_shots=len(rally_df)\n","print(f\"\\n🎯 Total Shots Detected Using Model Motion Analysis: {total_shots}\")\n","\n","out_csv=f\"{results_dir}/real_shot_detections_combined.csv\"\n","rally_df.to_csv(out_csv,index=False)\n","print(f\"📁 Shot list saved to: {out_csv}\")\n","\n","pd.set_option('display.max_rows', None)\n","pd.set_option('display.max_columns', None)\n","display(rally_df)\n","\n","step_7_module_3_passed=True\n","step_7_module_3_passed"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"-iXHi9f3dLHw","executionInfo":{"status":"ok","timestamp":1767610520722,"user_tz":-60,"elapsed":413488,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"748fcedf-7893-43ec-9a22-bf17a420c941"},"execution_count":33,"outputs":[{"output_type":"stream","name":"stdout","text":["🏸 Detecting shots using trained YOLOv11 detection model (players + shuttle)...\n"]},{"output_type":"stream","name":"stderr","t