e and enhance contrast\n","    heatmap_norm = heatmap / np.max(heatmap)\n","    heatmap_enhanced = np.power(heatmap_norm, contrast_power)\n","\n","    plt.subplot(1,2,i)\n","\n","    plt.imshow(frame_rgb)\n","\n","    # Overlay semi-transparent enhanced heatmap\n","    hm_plot = plt.imshow(\n","        heatmap_enhanced,\n","        cmap='jet',          # vivid blue→red palette\n","        alpha=0.75,\n","        extent=[0, frame_rgb.shape[1], frame_rgb.shape[0], 0]\n","    )\n","\n","    cv2.polylines(frame_rgb,[court_coords.reshape((-1,1,2))],\n","                  isClosed=True,color=(255,255,255),thickness=3)\n","\n","    plt.title(f\"{label} Movement Heatmap\")\n","    plt.axis('off')\n","\n","plt.colorbar(hm_plot, fraction=0.046, pad=0.04)\n","plt.tight_layout()\n","plt.show()\n","\n","os.makedirs(results_dir, exist_ok=True)\n","out_path=f\"{results_dir}/movement_heatmaps_visible.jpg\"\n","plt.savefig(out_path,bbox_inches=\"tight\")\n","print(f\"✅ Heatmaps saved to: {out_path}\")\n","\n","step_7_module_4_visible_passed=True\n","step_7_module_4_visible_passed"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":454},"id":"_GD-9Nfac4hv","executionInfo":{"status":"ok","timestamp":1767606369859,"user_tz":-60,"elapsed":1054,"user":{"displayName":"Muhammad Yasin","userId":"14932490641465775909"}},"outputId":"09e81968-871a-49e5-f9f4-be6cd93fa661"},"execution_count":16,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["✅ Heatmaps saved to: /content/drive/MyDrive/Badminton_Analytics_Project/results/movement_heatmaps_visible.jpg\n"]},{"output_type":"execute_result","data":{"text/plain":["True"]},"metadata":{},"execution_count":16},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 0 Axes>"]},"metadata":{}}]},{"cell_type":"code","source":["# @title STEP 7 —  Pose-annotated video segment with skeletons\n","# ----------------------------------------------------------------\n","\n","\n","cap_pose = cv2.VideoCapture(video_path)\n","total_frames = int(cap_pose.get(cv2.CAP_PROP_FRAME_COUNT))\n","sample_indices_pose = sorted(random.sample(range(total_frames), min(5, total_frames)))\n","\n","color_p1 = (80,255,80)\n","color_p2 = (255,180,60)\n","\n","for idx in sample_indices_pose:\n","    cap_pose.set(cv2.CAP_PROP_POS_FRAMES, idx)\n","    ret, frame_p = cap_pose.read()\n","    if not ret:\n","        continue\n","\n","    results_p = pose_model(frame_p)\n","    annotated_frame = frame_p.copy()\n","\n","    keypoints_list = results_p[0].keypoints.xy.cpu().numpy() if hasattr(results_p[0], 'keypoints') else []\n","\n","    if len(keypoints_list) > 0:\n","        for person_kpts in keypoints_list:\n","            mean_y=np.mean(person_kpts[:,1])\n","            color_used=color_p1 if mean_y<frame_p.shape[0]/2 else color_p2\n","\n","            limbs=[(5,7),(7,9),(6,8),(8,10),(11,13),(13,15),(12,14),(14,16),\n","                   (5,6),(11,12)]\n","            for i,j in limbs:\n","                x1,y1=person_kpts[i]; x2,y2=person_kpts[j]\n","                cv2.line(annotated_frame,(int(x1),int(y1)),(int(x2),int(y2)),color_used ,3 )\n","            for x,y in person_kpts:\n","                cv2.circle(annotated_frame,(int(x),int(y)),4,color_used ,-1 )\n","\n","            shoulder_mid=np.mean(person_kpts[[5 ,6 ]],axis=0)\n","            hip_mid=np.mean(person_kpts[[11 ,12 ]],axis=0)\n","\n","\n","\n","body_angle_rad=np.arctan2((shoulder_mid[1]-hip_mid[1]),(shoulder_mid[0]-hip_mid[0]))\n","body_angle_deg=np.degrees(body_angle_rad)%180\n","\n","left_leg_len=np.linalg.norm(person_kpts[15]-person_kpts[13])\n","right_leg_len=np.linalg.norm(person_kpts[16]-person_kpts[14])\n","leg_stretch_ratio=(left_leg_len+right_leg_len)/200.0\n","\n","label_text=f\"Angle:{body_angle_deg:.1f}° Stretch:{leg_stretch_ratio:.2f}\"\n","text_pos=(int(hip_mid[0])-50,int(hip_mid[1])+40)\n","cv2.putText(annotated_frame,label_text,text_pos,\n","           cv2.FONT_HERSHEY_SIMPLEX,\n","           0.7,color_used ,3 )\n","\n","plt.figure(figsize=(10 ,6 ))\n","plt.imshow(cv2.cvtColor(annotated_frame.copy(),cv2.COLOR_BGR2RGB ))\n","plt.title(f\"Pose-annotated Frame {idx}\")\n","plt.axis('off')\n","plt.show()\n","\n","cap_pose.release()\n","\n","\n","# --- Compute pose metrics for ALL frames and save ----------------------------\n","print(\"\\n📊 Calculating body angle & leg stretch for all frames...\")\n","\n","os.makedirs(f\"{results_dir}/pose_metrics\", exist_ok=True)\n","\n","cap_full=cv2.VideoCapture(video_path)\n","metrics_all=[]\n","frame_total=int(cap_full.get(cv2.CAP_PROP_FRAME_COUNT))\n","\n","# ✅ Added progress bar here ---------------------------------------------------\n","for fnum in tqdm(range(frame_total), desc=\"Processing Frames\", unit=\"frame\"):\n","    ret,img=cap_full.read()\n","    if not ret: break\n","    res=pose_model(img)\n","    klist=res[0].keypoints.xy.cpu().numpy() if hasattr(res[0],'keypoints') else []\n","    if len(klist)==0: continue\n","    for pk in klist:\n","        shoulder_mid=np.mean(pk[[5 ,6 ]],axis=0)\n","        hip_mid=np.mean(pk[[11 ,12 ]],axis=0)\n","        body_angle_rad=np.arctan2((shoulder_mid[1]-hip_mid[1]),(shoulder_mid[0]-hip_mid[0]))\n","        body_angle_deg=float(np.degrees(body_angle_rad)%180)\n","        left_leg_len=float(np.linalg.norm(pk[15]-pk[13]))\n","        right_leg_len=float(np.linalg.norm(pk[16]-pk[14]))\n","        leg_stretch_ratio=(left_leg_len+right_leg_len)/200.0\n","        metrics_all.append({\n","             \"Frame\":fnum,\n","             \"Body_Angle_deg\":round(body_angle_deg ,3 ),\n","             \"Leg_Stretch_Ratio\":round(leg_stretch_ratio ,3 )\n","         })\n","\n","cap_full.release()\n","\n","metrics_df=pd.DataFrame(metrics_all)\n","out_csv=f\"{results_dir}/pose_metrics/pose_angles_stretches_full_video.csv\"\n","metrics_df.to_csv(out_csv,index=False)\n","\n","print(f\"\\n✅