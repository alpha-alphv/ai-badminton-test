# ----- Generated analytics output (notebook + UI) -----
# Everything the notebook writes ends up under results/; the UI writes uploaded
# videos + per-job artifacts under ui/data/. Both are reproducible from source,
# so neither belongs in version control.
results/
ui/data/

# ----- Training runs / experiment artifacts -----
runs/
logs/
*.log

# ----- Model checkpoints (keep the deployed best.pt — see note below) -----
weights/last.pt

# ----- Temporary files -----
*.tmp
tmp/
.cache/
